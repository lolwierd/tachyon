# AniList OAuth configuration
ANILIST_CLIENT_ID=your-anilist-client-id
ANILIST_CLIENT_SECRET=your-anilist-client-secret
ANILIST_REDIRECT_URI=http://127.0.0.1:3000/api/anilist/callback

# Token encryption key (recommended — if not set, ANILIST_CLIENT_SECRET is used as fallback)
# Generate with: openssl rand -base64 32
# TACHYON_TOKEN_ENCRYPTION_KEY=

# Basic auth (optional — leave unset for no auth)
# TACHYON_BASIC_AUTH_USERNAME=
# TACHYON_BASIC_AUTH_PASSWORD=

# FlareSolverr endpoint for sources that need challenge handling
FLARESOLVERR_URL=http://127.0.0.1:8191
